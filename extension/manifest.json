{
  "manifest_version": 3,
  "name": "超星课件批量下载",
  "version": "1.0.5",
  "description": "多选章节，自动下载课件，可选 ZIP 打包，跳过无课件章节，按章节名称保存。",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "downloads", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://*.chaoxing.com/*", "*://*.chaoxing.com.cn/*", "https://*.cldisk.com/*", "https://raw.githubusercontent.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开课件批量下载" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["*://*.chaoxing.com/mycourse/studentstudy*", "*://*.chaoxing.com/mooc-ans/mycourse/studentstudy*"],
    "js": ["launcher.js"],
    "run_at": "document_idle"
  }]
}
